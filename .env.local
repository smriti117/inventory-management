# Application Settings
APP_NAME="Multi Vendor Inventory Management System"
APP_VERSION="1.0.0"
PORT=8000
IS_PROD=false

# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
SQL_ECHO=false

# JWT Configuration
JWT_SECRET_KEY="secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0
JWT_REFRESH_TOKEN_EXPIRE_DAYS=0

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=password

PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="admin"
PGADMIN_PORT=5050

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

LOG_LEVEL=""
